    "android:open": "npx cap open android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor-community/sqlite": "^7.0.0",
    "jeep-sqlite": "^2.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.3"
  }
}
